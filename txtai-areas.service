# Example systemd unit: copy to /etc/systemd/system/, change User and the paths, then
#   systemctl daemon-reload && systemctl enable --now txtai-areas
[Unit]
Description=txtai-areas search server
After=network-online.target
Wants=network-online.target

[Service]
User=txtai
WorkingDirectory=/opt/txtai-areas
EnvironmentFile=/opt/txtai-areas/.env
ExecStart=/opt/txtai-areas/venv/bin/uvicorn server:app --host 0.0.0.0 --port 9630
Restart=on-failure

[Install]
WantedBy=multi-user.target
