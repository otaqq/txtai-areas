# Copy to .env (not in git) and fill in.
# Key that clients send in the X-API-Key header
API_KEY=
# Embedding model, as LiteLLM names it. For an OpenAI-compatible server: openai/<model> and EMBEDDINGS_API_BASE
EMBEDDINGS_MODEL=openai/text-embedding-3-small
EMBEDDINGS_API_BASE=
EMBEDDINGS_API_KEY=
# Where the indexes are kept (default: ./data)
DATA_DIR=
# Login of the graph view (/ui). The UI is off while UI_PASSWORD is empty
UI_USER=admin
UI_PASSWORD=
